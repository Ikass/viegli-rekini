<div class="container" data-size="xs">

  <header class="stack auth-header">
    <div class="auth-logo">
      <span class="auth-logo-icon" aria-hidden="true">
        <%= tabler_icon("file-invoice", data: { size: "sm" }) %>
      </span>
    </div>
    <h1 class="auth-brand"><%= ViegliRekini::Application::APP_NAME %></h1>
  </header>

  <article class="card auth-card">
    <header class="auth-card-header">
      <h2 class="auth-title">Welcome back</h2>
      <p class="auth-subtitle">Sign in to continue</p>
    </header>

    <div class="stack">
      <%= form_with url: session_path, html: { class: "stack" } do |form| %>
        <fieldset class="stack auth-fieldset">
          <div class="field">
            <%= form.label :email_address, "Email" %>
            <%= form.email_field :email_address, required: true, autofocus: true,
                autocomplete: "username", placeholder: "name@company.com",
                value: params[:email_address] %>
          </div>

          <div class="field">
            <%= form.label :password, "Password" %>
            <%= form.password_field :password, required: true,
                autocomplete: "current-password", placeholder: "••••••••••", maxlength: 72 %>
          </div>
        </fieldset>

        <%= form.button "Sign in", class: "button",
            data: { variant: "primary", width: "full" } %>
      <% end %>

      <%= button_to "Try the demo", demo_session_path, class: "button",
          data: { variant: "secondary", width: "full" } %>
    </div>
  </article>

</div>

<%= render "shared/cloudflare_analytics" %>
