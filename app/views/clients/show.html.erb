<% content_for :title, @client.name %>

<h1><%= @client.name %></h1>

<div class="stack">
  <section aria-labelledby="client-details-heading" style="margin-block-end: var(--space-l);">
    <h2 id="client-details-heading" class="section-label"><%= t(".client_details") %></h2>
    <div class="card">
      <div>
        <dl>
          <% if @client.company_name.present? %>
            <dt><%= Client.human_attribute_name(:company_name) %></dt>
            <dd><%= @client.company_name %></dd>
          <% end %>

          <% if @client.email.present? %>
            <dt><%= Client.human_attribute_name(:email) %></dt>
            <dd><%= @client.email %></dd>
          <% end %>

          <% if @client.registration_number.present? %>
            <dt><%= Client.human_attribute_name(:registration_number) %></dt>
            <dd><%= @client.registration_number %></dd>
          <% end %>

          <% if @client.vat_number.present? %>
            <dt><%= Client.human_attribute_name(:vat_number) %></dt>
            <dd><%= @client.vat_number %></dd>
          <% end %>

          <dt><%= Client.human_attribute_name(:vat_regime) %></dt>
          <dd><%= client_vat_regime_label(@client.vat_regime) %></dd>

          <% if @client.country_code.present? %>
            <dt><%= Client.human_attribute_name(:country_code) %></dt>
            <dd><%= @client.country_code %></dd>
          <% end %>

          <% if @client.iban.present? %>
            <dt><%= Client.human_attribute_name(:iban) %></dt>
            <dd><%= @client.iban %></dd>
          <% end %>
        </dl>
      </div>
    </div>
  </section>

  <% if @client.address.present? || @client.city.present? || @client.postal_code.present? || @client.country.present? %>
    <section aria-labelledby="client-address-heading" style="margin-block-end: var(--space-l);">
      <h2 id="client-address-heading" class="section-label"><%= t(".address") %></h2>
      <div class="card">
        <div>
          <dl>
            <% if @client.address.present? %>
              <dt><%= Client.human_attribute_name(:address) %></dt>
              <dd><%= @client.address %></dd>
            <% end %>

            <% if @client.city.present? %>
              <dt><%= Client.human_attribute_name(:city) %></dt>
              <dd><%= @client.city %></dd>
            <% end %>

            <% if @client.postal_code.present? %>
              <dt><%= Client.human_attribute_name(:postal_code) %></dt>
              <dd><%= @client.postal_code %></dd>
            <% end %>

            <% if @client.country.present? %>
              <dt><%= Client.human_attribute_name(:country) %></dt>
              <dd><%= @client.country %></dd>
            <% end %>
          </dl>
        </div>
      </div>
    </section>
  <% end %>

  <section aria-labelledby="client-delivery-heading" style="margin-block-end: var(--space-l);">
    <h2 id="client-delivery-heading" class="section-label"><%= t(".e_invoice_delivery") %></h2>
    <div class="card">
      <div>
        <dl>
          <dt><%= Client.human_attribute_name(:delivery_channel) %></dt>
          <dd><%= client_delivery_channel_label(@client.delivery_channel) %></dd>

          <% if @client.is_budget_institution? %>
            <dt><%= Client.human_attribute_name(:is_budget_institution) %></dt>
            <dd><%= t(".yes") %></dd>
          <% end %>

          <% if @client.e_adrese_id.present? %>
            <dt><%= Client.human_attribute_name(:e_adrese_id) %></dt>
            <dd><%= @client.e_adrese_id %></dd>
          <% end %>
        </dl>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <%= link_to edit_client_path(@client), class: "button" do %>
      <%= tabler_icon("edit") %>
      <%= t("shared.actions.edit") %>
    <% end %>
    <%= button_to client_path(@client), method: :delete, class: "button", data: { variant: "danger" }, form: { data: { turbo_confirm: t(".delete_confirm", name: @client.name) } } do %>
      <%= tabler_icon("trash") %>
      <%= t("shared.actions.delete") %>
    <% end %>
    <%= link_to clients_path, class: "button", data: { variant: "ghost" } do %>
      <%= tabler_icon("arrow-left") %>
      <%= t(".back") %>
    <% end %>
  </div>
</div>
