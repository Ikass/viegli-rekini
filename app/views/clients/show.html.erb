<% content_for :title, @client.name %>

<h1><%= @client.name %></h1>

<dl>
  <% if @client.company_name.present? %>
    <dt>Company</dt>
    <dd><%= @client.company_name %></dd>
  <% end %>

  <% if @client.email.present? %>
    <dt>Email</dt>
    <dd><%= @client.email %></dd>
  <% end %>

  <% if @client.vat_number.present? %>
    <dt>VAT number</dt>
    <dd><%= @client.vat_number %></dd>
  <% end %>
</dl>

<%= link_to "Edit", edit_client_path(@client), class: "button" %>
<%= button_to "Delete", @client, method: :delete, class: "button", data: { variant: "danger", turbo_confirm: "Delete #{@client.name}? This cannot be undone." } %>
