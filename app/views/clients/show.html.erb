<% content_for :title, @client.name %>

<h1><%= @client.name %></h1>

<dl>
  <% if @client.company_name.present? %>
    <dt>Company</dt>
    <dd><%= @client.company_name %></dd>
  <% end %>

  <% if @client.email.present? %>
    <dt>Email</dt>
    <dd><%= @client.email %></dd>
  <% end %>

  <% if @client.vat_number.present? %>
    <dt>VAT number</dt>
    <dd><%= @client.vat_number %></dd>
  <% end %>

  <% if @client.country_code.present? %>
    <dt>Country code</dt>
    <dd><%= @client.country_code %></dd>
  <% end %>

  <% if @client.iban.present? %>
    <dt>IBAN</dt>
    <dd><%= @client.iban %></dd>
  <% end %>

  <dt>Delivery channel</dt>
  <dd><%= @client.delivery_channel.humanize %></dd>

  <% if @client.is_budget_institution? %>
    <dt>Budget institution</dt>
    <dd>Yes</dd>
  <% end %>

  <% if @client.e_adrese_id.present? %>
    <dt>E-adrese ID</dt>
    <dd><%= @client.e_adrese_id %></dd>
  <% end %>
</dl>

<div class="cluster">
  <%= link_to edit_client_path(@client), class: "button" do %>
    <%= tabler_icon("edit") %>
    Edit
  <% end %>
  <%= button_to client_path(@client), method: :delete, class: "button", data: { variant: "danger" }, form: { data: { turbo_confirm: "Delete #{@client.name}? This cannot be undone." } } do %>
    <%= tabler_icon("trash") %>
    Delete
  <% end %>
</div>

<%= link_to clients_path, class: "button", data: { variant: "ghost" } do %>
  <%= tabler_icon("arrow-left") %>
  Back to clients
<% end %>
