<%# locals: (client:) %>

<%= form_with model: client, html: { class: "stack" } do |form| %>
  <% if client.errors.any? %>
    <div role="alert">
      <% client.errors.full_messages.each do |message| %>
        <p class="flash" data-type="error"><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <section aria-labelledby="client-info-heading" style="margin-block-end: var(--space-l);">
    <h2 id="client-info-heading" class="section-label"><%= t(".client_details") %></h2>
    <div class="card">
      <div>
        <div class="fields-grid">
          <div class="field">
            <%= form.label :name %>
            <%= form.text_field :name, required: true, autofocus: true %>
          </div>
          <div class="field">
            <%= form.label :company_name %>
            <%= form.text_field :company_name %>
          </div>
          <div class="field">
            <%= form.label :email %>
            <%= form.email_field :email %>
          </div>
          <div class="field">
            <%= form.label :registration_number %>
            <%= form.text_field :registration_number %>
          </div>
          <div class="field">
            <%= form.label :vat_number %>
            <%= form.text_field :vat_number %>
          </div>
          <div class="field">
            <%= form.label :vat_regime %>
            <%= form.select :vat_regime, Client.vat_regimes.map { |k, _| [ client_vat_regime_label(k), k ] } %>
          </div>
          <div class="field">
            <%= form.label :iban %>
            <%= form.text_field :iban %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="address-heading" style="margin-block-end: var(--space-l);">
    <h2 id="address-heading" class="section-label"><%= t(".address") %></h2>
    <div class="card">
      <div>
        <div class="fields-grid">
          <div class="field">
            <%= form.label :address %>
            <%= form.text_field :address %>
          </div>
          <div class="field">
            <%= form.label :city %>
            <%= form.text_field :city %>
          </div>
          <div class="field">
            <%= form.label :postal_code %>
            <%= form.text_field :postal_code %>
          </div>
          <div class="field">
            <%= form.label :country %>
            <%= form.text_field :country %>
          </div>
          <div class="field">
            <%= form.label :country_code, t(".country_code") %>
            <%= form.text_field :country_code, placeholder: "LV" %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="delivery-heading" style="margin-block-end: var(--space-l);">
    <h2 id="delivery-heading" class="section-label"><%= t(".e_invoice_delivery") %></h2>
    <div class="card">
      <div>
        <div class="fields-grid">
          <div class="field">
            <%= form.label :delivery_channel %>
            <%= form.select :delivery_channel, Client.delivery_channels.map { |k, _| [ client_delivery_channel_label(k), k ] } %>
          </div>
          <div class="field">
            <%= form.label :e_adrese_id %>
            <%= form.text_field :e_adrese_id %>
          </div>
        </div>
        <div class="field" style="margin-block-start: var(--space-s);">
          <label>
            <%= form.check_box :is_budget_institution %>
            <%= t(".budget_institution") %>
          </label>
        </div>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <%= form.button class: "button", data: { variant: "primary" } do %>
      <%= tabler_icon("check") %>
      <%= t(".save") %>
    <% end %>
    <%= link_to client.persisted? ? client_path(client) : clients_path, class: "button" do %>
      <%= tabler_icon("x") %>
      <%= t("shared.actions.cancel") %>
    <% end %>
  </div>
<% end %>
