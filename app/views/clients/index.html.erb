<% content_for :title, "Clients" %>

<div class="actions">
  <h1>Clients</h1>
  <%= link_to "New client", new_client_path, role: "button" %>
</div>

<% if @clients.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Company</th>
        <th>Email</th>
        <th>VAT number</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @clients.each do |client| %>
        <tr>
          <td><%= link_to client.name, client %></td>
          <td><%= client.company_name %></td>
          <td><%= client.email %></td>
          <td><%= client.vat_number %></td>
          <td>
            <%= link_to "Edit", edit_client_path(client) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No clients yet. <%= link_to "Add your first client", new_client_path %>.</p>
<% end %>
