<% content_for :title, t(".title") %>

<div class="cluster" data-justify="space-between">
  <h1><%= t(".title") %></h1>
  <%= link_to new_client_path, class: "button", data: { variant: "primary" } do %>
  <%= tabler_icon("plus") %>
  <%= t(".new") %>
<% end %>
</div>

<% if @clients.any? %>
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th><%= t(".name") %></th>
          <th class="hide-mobile"><%= t(".company") %></th>
          <th class="hide-mobile"><%= t(".email") %></th>
          <th class="hide-mobile"><%= t(".vat_number") %></th>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @clients.each do |client| %>
          <tr>
            <td><%= link_to client.name, client %></td>
            <td class="hide-mobile"><%= client.company_name %></td>
            <td class="hide-mobile"><%= client.email %></td>
            <td class="hide-mobile"><%= client.vat_number %></td>
            <td class="col-actions">
              <%= link_to edit_client_path(client), class: "button" do %>
                <%= tabler_icon("edit") %>
                <%= t("shared.actions.edit") %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p><%= t(".empty") %> <%= link_to new_client_path, class: "button" do %>
  <%= tabler_icon("plus") %>
  <%= t(".add_first") %>
<% end %>.</p>
<% end %>
