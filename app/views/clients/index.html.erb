<% content_for :title, "Clients" %>

<div class="cluster" data-justify="space-between">
  <h1>Clients</h1>
  <%= link_to new_client_path, class: "button", data: { variant: "primary" } do %>
  <%= tabler_icon("plus") %>
  New client
<% end %>
</div>

<% if @clients.any? %>
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th class="hide-mobile">Company</th>
          <th class="hide-mobile">Email</th>
          <th class="hide-mobile">VAT number</th>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @clients.each do |client| %>
          <tr>
            <td><%= link_to client.name, client %></td>
            <td class="hide-mobile"><%= client.company_name %></td>
            <td class="hide-mobile"><%= client.email %></td>
            <td class="hide-mobile"><%= client.vat_number %></td>
            <td class="col-actions">
              <%= link_to edit_client_path(client), class: "button", data: { size: "sm" } do %>
                <%= tabler_icon("edit") %>
                Edit
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No clients yet. <%= link_to new_client_path, class: "button" do %>
  <%= tabler_icon("plus") %>
  Add your first client
<% end %>.</p>
<% end %>
