<%# locals: (invoices:) %>
<div class="table-wrapper">
  <table class="table">
    <thead>
      <tr>
        <th>Number</th>
        <th>Client</th>
        <th class="hide-mobile">Issued</th>
        <th class="hide-mobile">Due</th>
        <th class="col-numeric">Total</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% invoices.each do |invoice| %>
        <tr>
          <td><%= link_to invoice_number_or_draft(invoice), invoice_path(invoice) %></td>
          <td><%= invoice.client.name %></td>
          <td class="hide-mobile"><%= invoice.issued_on %></td>
          <td class="hide-mobile"><%= invoice.due_on %></td>
          <td class="col-numeric"><%= number_to_currency(invoice.total / 100.0, unit: "€") %></td>
          <td>
            <span class="badge" data-status="<%= invoice.display_status %>">
              <%= invoice.display_status.humanize %>
            </span>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
