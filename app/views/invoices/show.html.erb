<div class="invoice-page">
  <div class="stack">
    <header class="invoice-toolbar">
      <%= link_to invoices_path, class: "invoice-toolbar-back" do %>
        <%= tabler_icon("arrow-left") %>
        Back to invoices
      <% end %>

      <div class="cluster">
        <% unless @invoice.paid? || @invoice.void? %>
          <%= link_to print_invoice_path(@invoice), target: "_blank", class: "button", data: { size: "xs" } do %>
            <%= tabler_icon("printer") %>
            Print
          <% end %>
        <% end %>

        <% if @invoice.draft? %>
          <%= button_tag name: "commit", value: "send", type: "submit", form: "invoice_form", class: "button", data: { variant: "primary", size: "xs" } do %>
            <%= tabler_icon("send") %>
            Send invoice
          <% end %>
        <% elsif @invoice.sent? %>
          <%= button_to invoice_invoice_payments_path(@invoice), method: :post, class: "button", data: { variant: "primary", size: "xs" } do %>
            <%= tabler_icon("check") %>
            Record payment
          <% end %>
        <% else %>
          <%= link_to print_invoice_path(@invoice), target: "_blank", class: "button", data: { variant: "primary", size: "xs" } do %>
            <%= tabler_icon("printer") %>
            Print
          <% end %>
        <% end %>

        <% unless @invoice.void? %>
          <details class="overflow-menu" data-controller="overflow-menu" data-action="click@window->overflow-menu#close keydown@window->overflow-menu#closeOnEscape">
            <summary class="button" data-size="xs" title="More" aria-label="More">
              <%= tabler_icon("dots-vertical") %>
            </summary>
            <div class="overflow-menu-content">
              <% if @invoice.draft? %>
                <%= button_to invoice_path(@invoice), method: :delete, class: "button", data: { variant: "danger", size: "xs" }, form: { data: { turbo_confirm: "Delete this draft? This cannot be undone." } } do %>
                  <%= tabler_icon("trash") %>
                  Delete draft
                <% end %>
              <% else %>
                <%= button_to invoice_invoice_voids_path(@invoice), method: :post, class: "button", data: { variant: "danger", size: "xs" }, form: { data: { turbo_confirm: "Voiding keeps this invoice number reserved but marks it as cancelled. This can't be undone." } } do %>
                  <%= tabler_icon("ban") %>
                  Void invoice
                <% end %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    </header>

    <div class="invoice-heading">
      <h1><%= @invoice.invoice_number %></h1>
      <span class="badge" data-status="<%= @invoice.display_status %>"><%= @invoice.display_status.humanize %></span>
    </div>

    <% if @invoice.draft? %>
      <%= render "form", invoice: @invoice %>
    <% else %>
      <article class="card invoice-doc-card">
        <div>
          <%= render "document", invoice: @invoice %>
        </div>
      </article>
    <% end %>

    <% unless @invoice.draft? %>
      <section class="invoice-activity" aria-labelledby="invoice-activity-heading">
        <h2 id="invoice-activity-heading" class="section-label">Activity</h2>
        <ol class="invoice-activity-list">
          <li><span>Created</span><time datetime="<%= @invoice.created_at.iso8601 %>"><%= @invoice.created_at.to_date %></time></li>
          <% if @invoice.sent_at.present? %>
            <li><span>Sent</span><time datetime="<%= @invoice.sent_at.iso8601 %>"><%= @invoice.sent_at.to_date %></time></li>
          <% end %>
          <% if @invoice.paid_at.present? %>
            <li><span>Paid</span><time datetime="<%= @invoice.paid_at.iso8601 %>"><%= @invoice.paid_at.to_date %></time></li>
          <% end %>
          <% if @invoice.voided_at.present? %>
            <li><span>Voided</span><time datetime="<%= @invoice.voided_at.iso8601 %>"><%= @invoice.voided_at.to_date %></time></li>
          <% end %>
        </ol>
      </section>
    <% end %>
  </div>
</div>
