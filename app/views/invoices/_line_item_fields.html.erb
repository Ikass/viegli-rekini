<%# locals: (form:) %>

<% unit_code = form.object.unit_code.presence || "C62" %>
<% vat_rate = form.object.vat_rate.nil? ? 21 : form.object.vat_rate %>

<tr data-nested-form-field>
  <td>
    <% if form.object.persisted? %>
      <%= form.hidden_field :_destroy, value: "0" %>
    <% end %>
    <%= form.hidden_field :position %>

    <%= form.text_field :description, required: true, aria: { label: "Description" }, data: { line_item_fill: "description" } %>
  </td>
  <td class="col-numeric">
    <%= form.number_field :quantity, step: "0.01", min: "0.01", required: true, value: (form.object.quantity.presence || 1), aria: { label: "Quantity" }, data: { line_item_fill: "quantity" } %>
  </td>
  <td>
    <%= form.hidden_field :unit_code, value: unit_code, data: { line_item_fill: "unitCode" } %>
    <span class="line-item-meta" data-line-item-fill="unitLabel"><%= LineItem::UNIT_CODES[unit_code] %></span>
  </td>
  <td class="col-numeric">
    <%= form.number_field :unit_price, step: "0.01", min: "0", required: true, aria: { label: "Unit price" }, data: { line_item_fill: "unitPrice" } %>
  </td>
  <td>
    <%= form.hidden_field :tax_category_code, value: (form.object.tax_category_code.presence || "S"), data: { line_item_fill: "taxCategory" } %>
    <%= form.hidden_field :vat_rate, value: vat_rate, data: { line_item_fill: "vatRate" } %>
    <span class="line-item-meta" data-line-item-fill="vatLabel"><%= vat_rate_percentage(vat_rate) %></span>
  </td>
  <td class="col-actions">
    <button type="button" data-action="line-items#remove" class="button" data-variant="ghost-danger" data-size="sm" aria-label="Remove line item">
      <%= tabler_icon("trash") %>
    </button>
  </td>
</tr>
