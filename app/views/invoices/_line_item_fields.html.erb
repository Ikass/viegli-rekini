<%# locals: (form:) %>

<div data-nested-form-field>
  <% if form.object.persisted? %>
    <%= form.hidden_field :_destroy, value: "0" %>
  <% end %>

  <div>
    <%= form.label :description %>
    <%= form.text_field :description, required: true %>
  </div>

  <div>
    <%= form.label :quantity %>
    <%= form.number_field :quantity, step: "0.01", min: "0.01", required: true %>
  </div>

  <div>
    <%= form.label :unit_price, "Unit price (€)" %>
    <%= form.number_field :unit_price, step: "0.01", min: "0", required: true %>
  </div>

  <div>
    <%= form.label :vat_rate, "VAT rate (%)" %>
    <%= form.number_field :vat_rate, step: "0.01", min: "0", value: form.object.vat_rate || 0 %>
  </div>

  <%= form.hidden_field :position %>

  <button type="button" data-action="nested-form#remove">Remove</button>
</div>
