<div class="cluster" data-justify="space-between">
  <h1>Invoices</h1>
  <%= link_to new_invoice_path, class: "button", data: { variant: "primary" } do %>
    <%= tabler_icon("plus") %>
    New invoice
  <% end %>
</div>

<% if @invoices.any? %>
  <% if @status_filter %>
    <%# Filtered view (e.g. /invoices?status=overdue) — one group. %>
    <section class="flow">
      <h2 class="invoice-group-heading"><%= @status_filter.titleize %></h2>
      <%= render "table", invoices: @invoices %>
      <p>
        <strong>Total:</strong>
        <%= number_to_currency(@invoices.sum(&:total) / 100.0, unit: "€") %>
      </p>
    </section>
  <% else %>
    <%# Group invoices by status in lifecycle order: draft → sent → paid → void. %>
    <% { draft: 0, sent: 1, paid: 2, void: 3 }.each do |status, _| %>
      <% group = @invoices.select { |i| i.status == status.to_s } %>
      <% next if group.empty? %>

      <section class="flow">
        <h2 class="invoice-group-heading"><%= status.to_s.titleize %></h2>
        <%= render "table", invoices: group %>
        <p>
          <strong>Group total:</strong>
          <%= number_to_currency(group.sum(&:total) / 100.0, unit: "€") %>
        </p>
      </section>
    <% end %>
  <% end %>
<% else %>
  <p>No invoices yet. <%= link_to new_invoice_path, class: "button" do %>
  <%= tabler_icon("plus") %>
  Create your first invoice
<% end %>.</p>
<% end %>
