<%# locals: (invoice:) %>

<% account = invoice.account %>
<% client = invoice.client %>
<% items_by_rate = invoice.line_items.group_by(&:vat_rate) %>

<div class="invoice-doc">
  <div class="invoice-header">
    <div>
      <p class="company-name"><%= account.company_name.presence || account.name %></p>
      <p class="issuer-details">
        <% if account.registration_number.present? %>
          Reg. No: <%= account.registration_number %>
        <% end %>
      </p>
      <p class="issuer-details">
        <% if account.vat_number.present? %>
          VAT: <%= account.vat_number %>
        <% end %>
      </p>
      <% if account.address.present? || account.city.present? || account.postal_code.present? %>
        <p class="issuer-details">
          <%= [account.address, account.postal_code, account.city].compact.join(", ") %>
          <% if account.country.present? %>
            · <%= account.country %>
          <% end %>
        </p>
      <% end %>
    </div>
    <div class="invoice-title">
      <h1>Invoice</h1>
      <dl class="invoice-meta">
        <dt>No.:</dt>
        <dd><%= invoice.invoice_number %></dd>
        <dt>Issued:</dt>
        <dd><%= invoice.issued_on %></dd>
        <dt>Due:</dt>
        <dd><%= invoice.due_on %></dd>
      </dl>
    </div>
  </div>

  <hr class="header-rule">

  <div class="bill-to">
    <h2>Bill to</h2>
    <p class="company-name"><%= client.company_name.presence || client.name %></p>
    <% if client.company_name.present? %>
      <p><%= client.name %></p>
    <% end %>
    <% if client.vat_number.present? %>
      <p>VAT: <%= client.vat_number %></p>
    <% elsif client.registration_number.present? %>
      <p>Reg. No: <%= client.registration_number %></p>
    <% end %>
    <% if client.address.present? %>
      <p><%= client.address %></p>
    <% end %>
    <% if client.city.present? || client.postal_code.present? %>
      <p><%= [client.postal_code, client.city].compact.join(" ") %></p>
    <% end %>
  </div>

  <table class="line-items">
    <thead>
      <tr>
        <th class="col-desc">Description</th>
        <th class="col-qty numeric">Qty</th>
        <th class="col-price numeric">Unit price</th>
        <th class="col-vat numeric">VAT</th>
        <th class="col-total numeric">Total</th>
      </tr>
    </thead>
    <tbody>
      <% invoice.line_items.each do |item| %>
        <tr>
          <td class="col-desc desc-cell"><%= item.description %></td>
          <td class="col-qty numeric"><%= item.quantity %></td>
          <td class="col-price numeric"><%= number_to_currency(item.unit_price_cents / 100.0, unit: "€") %></td>
          <td class="col-vat numeric"><%= vat_rate_percentage(item.vat_rate) %></td>
          <td class="col-total numeric"><%= number_to_currency(item.total / 100.0, unit: "€") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <dl class="totals">
    <% items_by_rate.each do |rate, items| %>
      <dt>Taxable (VAT <%= vat_rate_percentage(rate) %>)</dt>
      <dd class="numeric"><%= number_to_currency(items.sum(&:subtotal) / 100.0, unit: "€") %></dd>
      <dt>VAT <%= vat_rate_percentage(rate) %></dt>
      <dd class="numeric"><%= number_to_currency(items.sum(&:vat_amount) / 100.0, unit: "€") %></dd>
    <% end %>
    <dt class="total-row">Total</dt>
    <dd class="total-row numeric"><%= number_to_currency(invoice.total / 100.0, unit: "€") %></dd>
  </dl>

  <% if account.bank_name.present? || account.bank_account.present? %>
    <div class="payment-details">
      <h2>Payment details</h2>
      <p>
        <% if account.bank_name.present? %><%= account.bank_name %> · <% end %>
        <% if account.bank_account.present? %>IBAN <%= account.bank_account %><% end %>
        <% if account.bank_swift.present? %> · SWIFT/BIC <%= account.bank_swift %><% end %>
      </p>
    </div>
  <% end %>

  <% if invoice.vat_regime_note.present? %>
    <p class="vat-regime-note"><%= invoice.vat_regime_note %></p>
  <% end %>

  <% if invoice.notes.present? %>
    <div class="notes">
      <h2>Notes</h2>
      <p><%= invoice.notes %></p>
    </div>
  <% end %>

  <div class="compliance-footer">
    <p class="signature-note">
      This invoice is issued electronically and does not require a signature,
      as the underlying transaction is substantiated by the agreement/order
      it relates to.
    </p>
  </div>
</div>
