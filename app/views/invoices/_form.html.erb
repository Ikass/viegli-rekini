<%# locals: (invoice:) %>

<%= form_with model: invoice, html: { class: "stack", id: "invoice_form" }, data: { controller: "line-items" } do |form| %>
  <% if invoice.errors.any? %>
    <div role="alert">
      <% invoice.errors.full_messages.each do |message| %>
        <p class="flash" data-type="error"><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <section aria-labelledby="invoice-details-heading" style="margin-block-end: var(--space-l);">
    <h2 id="invoice-details-heading" class="section-label">Invoice details</h2>
    <div class="card">
      <div>
        <div class="field">
          <%= form.label :client_id, "Client" %>
          <%= form.collection_select :client_id, Current.user.account.clients, :id, :name, { prompt: "Select a client" }, required: true %>
        </div>

        <div class="fields-inline" style="margin-block-start: var(--space-s);">
          <div class="field">
            <%= form.label :issued_on, "Issued on" %>
            <%= form.date_field :issued_on, required: true %>
          </div>
          <div class="field">
            <%= form.label :due_on, "Due on" %>
            <%= form.date_field :due_on, required: true %>
          </div>
        </div>

        <div class="field" style="margin-block-start: var(--space-s);">
          <%= form.label :buyer_reference, "Buyer reference" %>
          <%= form.text_field :buyer_reference, placeholder: "e.g. purchase order number (optional)" %>
        </div>

        <div class="field" style="margin-block-start: var(--space-s);">
          <%= form.label :notes %>
          <%= form.text_area :notes, rows: 3 %>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="line-items-heading" style="margin-block-end: var(--space-l);">
    <h2 id="line-items-heading" class="section-label">Line items</h2>
    <div class="card">
      <div>
        <div class="table-wrapper">
          <table class="table line-items-form">
            <thead>
              <tr>
                <th>Description</th>
                <th class="col-numeric">Qty</th>
                <th>Unit</th>
                <th class="col-numeric">Unit price</th>
                <th>VAT</th>
                <th class="col-actions"></th>
              </tr>
            </thead>
            <tbody data-line-items-target="container">
              <%= form.fields_for :line_items do |line_item_form| %>
                <%= render "invoices/line_item_fields", form: line_item_form %>
              <% end %>
            </tbody>
          </table>
        </div>

        <template data-line-items-target="template">
          <%= form.fields_for :line_items, LineItem.new, child_index: "NEW_RECORD" do |line_item_form| %>
            <%= render "invoices/line_item_fields", form: line_item_form %>
          <% end %>
        </template>

        <div class="cluster" style="margin-block-start: var(--space-s);">
          <button type="button" data-action="line-items#add" class="button">
            <%= tabler_icon("plus") %>
            Add line item
          </button>
          <%= select_tag :product_adder,
                options_for_select([ [ "Add from product…", "" ] ]) + options_from_collection_for_select(Current.user.account.products, :id, :name),
                aria: { label: "Add from product" },
                style: "inline-size: 16rem;",
                data: { line_items_target: "productSelector", action: "line-items#addFromProduct" } %>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="totals-heading" style="margin-block-end: var(--space-l);">
    <h2 id="totals-heading" class="section-label">Totals</h2>
    <div class="card">
      <div>
        <dl>
          <dt>Subtotal</dt>
          <dd><%= number_to_currency(invoice.subtotal / 100.0, unit: "€") %></dd>
          <dt>VAT</dt>
          <dd><%= number_to_currency(invoice.vat_total / 100.0, unit: "€") %></dd>
          <dt>Total</dt>
          <dd><strong><%= number_to_currency(invoice.total / 100.0, unit: "€") %></strong></dd>
        </dl>
      </div>
    </div>
  </section>

  <div class="form-actions">
    <%= form.button name: "commit", value: "save", class: "button", data: { variant: "primary" } do %>
      <%= tabler_icon("check") %>
      Save invoice
    <% end %>
    <%= link_to (invoice.persisted? ? invoice_path(invoice) : invoices_path), class: "button" do %>
      <%= tabler_icon("x") %>
      Cancel
    <% end %>
  </div>
<% end %>
