<% content_for :title, t(".title") %>

<div class="cluster" data-justify="space-between">
  <h1><%= t(".title") %></h1>
  <%= link_to new_product_path, class: "button", data: { variant: "primary" } do %>
  <%= tabler_icon("plus") %>
  <%= t(".new") %>
<% end %>
</div>

<% if @products.any? %>
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th><%= t(".name") %></th>
          <th class="col-numeric"><%= t(".price") %></th>
          <th class="hide-mobile"><%= t(".unit") %></th>
          <th class="col-numeric hide-mobile"><%= t(".vat_rate") %></th>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td><%= link_to product.name, product %></td>
            <td class="col-numeric"><%= number_to_currency(product.default_price_cents / 100.0, unit: "€") %></td>
            <td class="hide-mobile"><%= unit_code_label(product.unit_code) %></td>
            <td class="col-numeric hide-mobile"><%= vat_rate_percentage(product.default_vat_rate) %></td>
            <td class="col-actions"><%= link_to edit_product_path(product), class: "button" do %>
              <%= tabler_icon("edit") %>
              <%= t("shared.actions.edit") %>
            <% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p><%= t(".empty") %> <%= link_to new_product_path, class: "button" do %>
  <%= tabler_icon("plus") %>
  <%= t(".add_first") %>
<% end %>.</p>
<% end %>
