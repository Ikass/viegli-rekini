<% content_for :title, "Products" %>

<div class="cluster" data-justify="space-between">
  <h1>Products</h1>
  <%= link_to new_product_path, class: "button", data: { variant: "primary" } do %>
  <%= tabler_icon("plus") %>
  New product
<% end %>
</div>

<% if @products.any? %>
  <div class="table-wrapper">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th class="col-numeric">Price</th>
          <th class="hide-mobile">Unit</th>
          <th class="col-numeric hide-mobile">VAT rate</th>
          <th class="col-actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td><%= link_to product.name, product %></td>
            <td class="col-numeric"><%= number_to_currency(product.default_price_cents / 100.0, unit: "€") %></td>
            <td class="hide-mobile"><%= LineItem::UNIT_CODES[product.unit_code] || product.unit_code %></td>
            <td class="col-numeric hide-mobile"><%= vat_rate_percentage(product.default_vat_rate) %></td>
            <td class="col-actions"><%= link_to edit_product_path(product), class: "button", data: { size: "sm" } do %>
              <%= tabler_icon("edit") %>
              Edit
            <% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No products yet. <%= link_to new_product_path, class: "button" do %>
  <%= tabler_icon("plus") %>
  Add your first product
<% end %>.</p>
<% end %>
