<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "E-Rēķini" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="container">
      <nav>
        <ul>
        <li><strong><%= link_to "E-Rēķini", root_path %></strong></li>
        </ul>
        <% if authenticated? %>
          <ul>
            <li><%= link_to "Invoices", root_path %></li>
            <li><%= link_to "Clients", clients_path %></li>
            <li><%= link_to "Products", products_path %></li>
            <li><%= link_to "Settings", edit_account_path %></li>
            <li><%= button_to "Sign out", session_path, method: :delete %></li>
          </ul>
        <% end %>
      </nav>
    </header>

    <main class="container">
      <% if notice %>
        <p class="flash" data-type="notice" role="status"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="flash" data-type="alert" role="alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
