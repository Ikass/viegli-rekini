<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || ViegliRekini::Application::APP_NAME %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="top-bar">
      <nav>
        <ul>
          <li class="top-bar-brand">
            <strong><%= link_to root_path, aria: { label: ViegliRekini::Application::APP_NAME } do %>
              <%= tabler_icon("file-invoice", data: { size: "lg" }) %>
              <span class="top-bar-brand-text"><%= ViegliRekini::Application::APP_NAME %></span>
            <% end %></strong>
          </li>
          <% if authenticated? %>
            <li><%= link_to edit_account_path, class: "button", data: { variant: "ghost", size: "sm" } do %>
              <%= tabler_icon("settings") %>
              Account
            <% end %></li>
            <li><%= button_to session_path, method: :delete, class: "button", data: { variant: "ghost-danger", size: "sm" } do %>
              <%= tabler_icon("logout") %>
              Sign out
            <% end %></li>
          <% else %>
            <li><%= link_to "Sign in", new_session_path, class: "button", data: { variant: "ghost", size: "sm" } %></li>
          <% end %>
        </ul>
      </nav>
    </header>

    <div class="app-layout">
      <% if authenticated? %>
        <aside class="sidebar">
          <nav>
            <ul>
              <li><%= link_to root_path, aria: current_page?(root_path) ? { current: "page" } : {} do %>
                  <%= tabler_icon("dashboard") %>
                  Dashboard
                <% end %></li>
              <li><%= link_to invoices_path, aria: controller_name == "invoices" ? { current: "page" } : {} do %>
                  <%= tabler_icon("file-invoice") %>
                  Invoices
                <% end %></li>
              <li><%= link_to clients_path, aria: controller_name == "clients" ? { current: "page" } : {} do %>
                  <%= tabler_icon("users") %>
                  Clients
                <% end %></li>
              <li><%= link_to products_path, aria: controller_name == "products" ? { current: "page" } : {} do %>
                  <%= tabler_icon("package") %>
                  Products
                <% end %></li>
            </ul>
          </nav>
        </aside>
      <% end %>
      <main class="container flow">
        <% if notice %>
          <p class="flash" data-type="notice" role="status"><%= notice %></p>
        <% end %>
        <% if alert %>
          <p class="flash" data-type="alert" role="alert"><%= alert %></p>
        <% end %>

        <%= yield %>
      </main>
    </div>
    <%= render "shared/footer" %>
  </body>
</html>
