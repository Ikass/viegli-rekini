<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("landing.show.meta_title") %></title>
    <meta name="description" content="<%= t("landing.show.meta_description") %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <% lv_url = root_url %>
    <% en_url = root_url(locale: :en) %>
    <link rel="canonical" href="<%= I18n.locale == :en ? en_url : lv_url %>">
    <link rel="alternate" hreflang="lv" href="<%= lv_url %>">
    <link rel="alternate" hreflang="en" href="<%= en_url %>">
    <link rel="alternate" hreflang="x-default" href="<%= lv_url %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="landing-page">
    <%= yield %>

    <%= render "shared/cloudflare_analytics" %>
  </body>
</html>
