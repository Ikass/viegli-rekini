<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Print — <%= @invoice.invoice_number %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>

    <style>
      /* ── Page setup ────────────────────────────────────────── */

      @page {
        size: A4;
        margin: 15mm 12mm;

        /* Suppress browser-added headers/footers (URL, page number) */
        @top-left   { content: none; }
        @top-right  { content: none; }
        @bottom-left  { content: none; }
        @bottom-right { content: none; }
      }

      /* ── Base ──────────────────────────────────────────────── */

      body {
        display: block;
        min-height: auto;
        font-family: var(--print-font);
        font-size: var(--print-size-base);
        line-height: 1.5;
        color: var(--print-ink);
        margin: 0;
        padding: 0;
        background-color: var(--print-surface);

        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }

      /* ── Screen-only card wrapper ───────────────────────────── */
      /* On screen the invoice floats as a white card on a grey   */
      /* background, mimicking A4 paper. On print it disappears.  */

      .print-page {
        background-color: var(--print-card);
        max-width: 210mm;
        margin-inline: auto;
        margin-block: var(--print-gap-lg);
        padding: 15mm 12mm;
        border: 1pt solid var(--print-border);
        border-radius: 4px;
        box-shadow: 0 4px 24px oklch(0.20 0.005 264 / 0.12);
      }

      @media screen {
        .print-page {
          aspect-ratio: 210 / 297;
          max-height: calc(100vh - 2 * var(--print-gap-lg));
          overflow: auto;
        }
      }

      @media print {
        body {
          background: none;
        }

        .print-page {
          max-width: none;
          margin: 0;
          padding: 0;
          border: none;
          border-radius: 0;
          box-shadow: none;
        }

        .no-print {
          display: none !important;
        }
      }
    </style>
  </head>

  <body>
    <div class="print-page">
      <%= yield %>
    </div>
  </body>
</html>
