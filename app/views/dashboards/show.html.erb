<div class="page-header">
  <h1><%= t("dashboards.title") %></h1>
  <%= link_to new_invoice_path, class: "button", data: { variant: "primary" } do %>
    <%= tabler_icon("plus") %>
    <%= t("dashboards.new_invoice") %>
  <% end %>
</div>

<section class="card summary-card">
  <div class="summary">
    <div class="summary-stat">
      <span class="summary-label"><%= t("dashboards.summary.outstanding") %></span>
      <span class="summary-value" data-testid="kpi-outstanding"><%= number_to_currency(@outstanding_total / 100.0, unit: "€") %></span>
    </div>

    <% if @overdue_count > 0 %>
      <%= link_to invoices_path(status: "overdue"), class: "summary-stat summary-stat--link" do %>
        <span class="summary-label"><%= t("dashboards.summary.overdue") %></span>
        <span class="summary-value-wrap">
          <span class="summary-value" data-testid="kpi-overdue">
            <%= number_to_currency(@overdue_total / 100.0, unit: "€") %>
            <%= tabler_icon("chevron-right", data: { size: "sm" }) %>
          </span>
          <span class="summary-count"><%= t("dashboards.summary.overdue_count", count: @overdue_count) %></span>
        </span>
      <% end %>
    <% else %>
      <div class="summary-stat">
        <span class="summary-label"><%= t("dashboards.summary.overdue") %></span>
        <span class="summary-value" data-testid="kpi-overdue"><%= number_to_currency(@overdue_total / 100.0, unit: "€") %></span>
      </div>
    <% end %>

    <div class="summary-stat">
      <span class="summary-label"><%= t("dashboards.summary.paid_this_month") %></span>
      <span class="summary-value" data-testid="kpi-paid"><%= number_to_currency(@paid_total / 100.0, unit: "€") %></span>
    </div>
  </div>
</section>

<% if @recent_invoices.any? %>
  <section class="card recent-activity">
    <header class="recent-activity-header">
      <h3><%= t("dashboards.recent_activity") %></h3>
      <%= link_to invoices_path, class: "view-all-link" do %>
        <%= t("dashboards.view_all") %> →
      <% end %>
    </header>
    <div>
      <% @recent_invoices.each do |invoice| %>
        <%= link_to invoice_path(invoice), class: "activity-item" do %>
          <div class="activity-item-info">
            <strong><%= invoice.client.name %></strong>
            <span>#<%= invoice.invoice_number %> · <%= number_to_currency(invoice.total / 100.0, unit: "€") %></span>
          </div>
          <span class="badge" data-status="<%= invoice.display_status %>"><%= invoice.display_status.humanize %></span>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
